#!/bin/sh

set -eu

bin_dir=$(CDPATH= cd -- "${0%/*}" && pwd)
arch=$(/usr/bin/uname -m)

case "$arch" in
  arm64)
    companion="$bin_dir/mind-diary-local-darwin-arm64"
    ;;
  x86_64)
    companion="$bin_dir/mind-diary-local-darwin-amd64"
    ;;
  *)
    printf '%s\n' "Mind Diary local companion does not support macOS architecture: $arch" >&2
    exit 1
    ;;
esac

if [ ! -x "$companion" ]; then
  printf '%s\n' 'Mind Diary local companion binary is missing or not executable.' >&2
  exit 1
fi

exec "$companion" "$@"

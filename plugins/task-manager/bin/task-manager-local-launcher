#!/bin/sh

set -eu

bin_dir=$(CDPATH= cd -- "${0%/*}" && pwd)
os=$(uname -s)
arch=$(uname -m)

case "$os:$arch" in
  Darwin:arm64)
    companion="$bin_dir/task-manager-local-darwin-arm64"
    ;;
  Darwin:x86_64)
    companion="$bin_dir/task-manager-local-darwin-amd64"
    ;;
  Linux:x86_64|Linux:amd64)
    companion="$bin_dir/task-manager-local-linux-amd64"
    ;;
  Linux:aarch64|Linux:arm64)
    companion="$bin_dir/task-manager-local-linux-arm64"
    ;;
  *)
    printf '%s\n' "Task Manager local companion does not support platform: $os $arch" >&2
    exit 1
    ;;
esac

if [ ! -x "$companion" ]; then
  printf '%s\n' 'Task Manager local companion binary is missing or not executable.' >&2
  exit 1
fi

exec "$companion" "$@"
